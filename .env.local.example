# Copy this file to .env.local for local dev, and set the same
# keys in Vercel → Project → Settings → Environment Variables.

# Supabase project URL and anon (public) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# service_role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used only by API routes that need elevated access (none required
# for this v1 dashboard, reserved for future Gemini/image pipeline).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloudinary — used for direct browser uploads from the Admin Panel
# (e.g. the home page video). Safe for the browser: unsigned uploads
# are scoped to this one upload preset, which you configure in the
# Cloudinary dashboard to only accept video files.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
